{
  "name": "autoprime-pdi",
  "version": "0.1.0",
  "private": true,
  "description": "Autoprime Tata PDI Management Platform — Dhoot Group",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:web": "pnpm --filter web build",
    "deploy:web": "pnpm --filter web build",
    "deploy": "wrangler deploy",
    "dev": "turbo dev",
    "db": "node services/local-db/server.mjs",
    "setup:db": "node scripts/setup-database.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:design": "node scripts/check-design-tokens.mjs",
    "clean": "turbo clean && find . -name node_modules -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.114.0"
  },
  "packageManager": "pnpm@9.14.0"
}
